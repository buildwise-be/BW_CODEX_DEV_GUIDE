{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buildwise-be/BW_CODEX_DEV_GUIDE/schema/framework-manifest.schema.json",
  "title": "BW Codex Development Framework Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "version",
    "sourceRepository",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 2
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "sourceRepository": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "source",
          "owner",
          "installMode",
          "required"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "enum": [
              "Framework",
              "Project",
              "Generated"
            ]
          },
          "installMode": {
            "enum": [
              "managed",
              "create-if-missing"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
